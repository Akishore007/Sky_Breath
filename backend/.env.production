# SkyBreath Production Backend Configuration
# Use this file when deploying to Vercel, Render, AWS, etc.

# ============================================================================
# Security Settings
# ============================================================================
DEBUG=False
# REPLACE with your actual random secret key in production!
SECRET_KEY=production_secret_key_change_me_to_something_very_secure

# REPLACE with your actual live domain names separated by commas
ALLOWED_HOSTS=skybreath.com,www.skybreath.com,api.skybreath.com
CORS_ALLOWED_ORIGINS=https://skybreath.com,https://www.skybreath.com

# Enforce secure cookies (Uncomment when HTTPS is enabled)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ============================================================================
# Application APIs
# ============================================================================
OPENWEATHER_API_KEY=your_openweather_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ============================================================================
# Database Configuration (PostgreSQL example)
# ============================================================================
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=skybreath_prod
# DB_USER=your_production_user
# DB_PASSWORD=your_production_password
# DB_HOST=db.yourhosting.com
# DB_PORT=5432

IS_DEVELOPMENT=False
